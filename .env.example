ENV=dev
APP_NAME="MailOps AI API"
API_CORS_ORIGINS='["http://localhost:5173"]'

DATABASE_URL="sqlite:///./mailops.db"

SECRET_KEY="REPLACE_ME_WITH_A_SECURE_RANDOM_SECRET"
PUBLIC_API_KEY="mailops-dev-key"
