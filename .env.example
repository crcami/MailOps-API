ENV=prod

# Use Postgres em produção 
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# URL do front em produção (Vercel)
FRONTEND_BASE_URL=https://your-frontend.vercel.app

# CORS (seu config já aceita lista JSON ou separado por vírgula)
API_CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

AI_PROVIDER=local_ml

# Obrigatório no  projeto (senão dá 500)
PUBLIC_API_KEY=change-me

# SMTP opcional
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MailOps AI <no-reply@mailops.ai>
